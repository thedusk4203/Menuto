  "$id": "urn:menuto:domain:foundation:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Bundle of named definitions; select a $defs reference to validate a document. Planner, validation and mutation handoffs are m0 drafts. Cross-field semantic guards run in Python, not JSON Schema alone.",
  "title": "Menuto M0 domain contracts — draft handoffs, no business HTTP endpoints"
