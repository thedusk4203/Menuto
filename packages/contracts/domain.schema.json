        "missing_contracts": {
          "default": [
            "ROOT_GOAL_POLICY",
            "GROUNDED_RECIPE_FACTS",
            "CHRONOLOGICAL_EVENTS",
            "SCENARIO_QUOTES",
            "HORIZON_BRIDGE"
          ],
          "items": {
            "enum": [
              "ROOT_GOAL_POLICY",
              "GROUNDED_RECIPE_FACTS",
              "CHRONOLOGICAL_EVENTS",
              "SCENARIO_QUOTES",
              "HORIZON_BRIDGE"
