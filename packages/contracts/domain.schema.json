    "YieldConversion": {
      "additionalProperties": false,
      "description": "Yield evidence is contextual. Cooking yield may exceed 1 (e.g. cooked rice).",
      "properties": {
        "context_ref": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Context Ref",
          "type": "string"
        },
        "factor": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "decimal_places": 6,
          "gt": 0,
          "max_digits": 18,
          "title": "Factor"
        },
        "kind": {
          "enum": [
