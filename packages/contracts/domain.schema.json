            "type": "string"
          },
          "title": "Missing Contracts",
          "type": "array"
        },
        "opening_assets": {
          "items": {
            "$ref": "#/$defs/MaterialFact"
          },
          "title": "Opening Assets",
          "type": "array"
        },
        "request": {
          "$ref": "#/$defs/PlannerRequestDraft"
        },
        "validation_ready": {
          "const": false,
