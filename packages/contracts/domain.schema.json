          "pattern": "^[a-f0-9]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "source": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Source",
          "type": "string"
        },
        "version": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "source",
        "version",
        "fingerprint"
      ],
      "title": "SourceVersion",
      "type": "object"
    },
    "ValidationFinding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Code",
          "type": "string"
        },
        "proof_refs": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Proof Refs",
          "type": "array"
        },
        "scope_ref": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Scope Ref",
          "type": "string"
        },
        "severity": {
          "enum": [
            "FATAL",
            "ERROR",
            "WARNING",
            "INFO"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_domain": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Source Domain",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "source_domain",
        "scope_ref",
        "proof_refs"
      ],
      "title": "ValidationFinding",
      "type": "object"
    },
    "ValidationReportDraft": {
      "additionalProperties": false,
      "properties": {
        "activation_authorized": {
          "const": false,
          "default": false,
          "title": "Activation Authorized",
          "type": "boolean"
        },
        "contract_version": {
          "const": "validation-report.m0-draft.1",
          "default": "validation-report.m0-draft.1",
          "title": "Contract Version",
          "type": "string"
        },
        "expected_revision": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Revision"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/ValidationFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "mode": {
          "enum": [
            "PRECOMMIT_VALIDATION",
            "POSTFACT_VALIDATION"
          ],
          "title": "Mode",
          "type": "string"
        },
        "subject_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Subject Hash",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "subject_hash",
        "expected_revision",
        "findings"
      ],
      "title": "ValidationReportDraft",
      "type": "object"
    },
    "ValidationSubjectDraft": {
      "additionalProperties": false,
      "properties": {
        "canonical_members": {
          "items": {
            "$ref": "#/$defs/CanonicalMemberSafety"
          },
          "minItems": 1,
          "title": "Canonical Members",
          "type": "array"
        },
        "contract_version": {
          "const": "validation-subject.m0-draft.1",
          "default": "validation-subject.m0-draft.1",
          "title": "Contract Version",
          "type": "string"
        },
        "household_id": {
          "format": "uuid",
          "title": "Household Id",
          "type": "string"
